def get_secret_safe(name, required=True):
    val = os.environ.get(name) or FILE_SECRETS.get(name)
    source = "env/file"
    if not val:
        try:
            from kaggle_secrets import UserSecretsClient
            val = UserSecretsClient().get_secret(name)
            source = "kaggle_secrets"
        except Exception:
            val = None
    if val:
        log(f"  -> Secret '{name}' loaded OK (source={source}, len={len(val.strip())})")
        return val.strip().strip('"').strip("'")
    if required:
        raise ValueError(f"Missing required secret: '{name}'.")
    log(f"  -> Optional secret '{name}' not set.")
    return None


