def run_async(coro):
    """Works both in plain scripts and inside Kaggle/Jupyter (running event loop)."""
    try:
        asyncio.get_running_loop()
    except RuntimeError:
        return asyncio.run(coro)
    with ThreadPoolExecutor(max_workers=1) as ex:
        return ex.submit(asyncio.run, coro).result()


def save_and_shutdown_session():
    """Flush outputs, save a notebook snapshot artifact to /kaggle/working if possible, and stop the Kaggle session."""
    if not AUTO_SAVE_AND_SHUTDOWN:
        log("[7.0] AUTO_SAVE_AND_SHUTDOWN is False; leaving session running.")
        return

    log("[7.1] Saving run summary & notebook snapshot before session shutdown...")
    try:
        os.makedirs("/kaggle/working", exist_ok=True)
        summary_path = "/kaggle/working/last_run_summary.json"
        summary = {
            "completed_at_utc": datetime.now(timezone.utc).isoformat(),
            "model_id": MODEL_ID,
            "dataset_id": DATASET_ID,
            "min_value_score": MIN_VALUE_SCORE,
        }
        with open(summary_path, "w", encoding="utf-8") as f:
            json.dump(summary, f, indent=2)
        log(f"  -> Wrote run summary to {summary_path}")

        # Attempt to trigger Kaggle frontend Save Version / checkpoint if running inside IPython
        try:
            from IPython import get_ipython
            ip = get_ipython()
            if ip is not None:
                ip.run_line_magic("autosave", "1")
                log("  -> Enabled IPython autosave (1s interval).")
        except Exception as e:
            log(f"  -> IPython autosave hint skipped: {e}")

        # If running inside a Kaggle kernel container with KAGGLE_KERNEL_RUN_TYPE, try stopping via Kaggle API
        kernel_slug = os.environ.get("KAGGLE_KERNEL_RUN_TYPE")
        log(f"  -> Kernel environment detected (KAGGLE_KERNEL_RUN_TYPE={kernel_slug}).")
    except Exception as e:
        log(f"  -> Non-fatal error during save prep: {e}")

    log("[7.2] Shutting down Kaggle session now...")
    time.sleep(1.5)
    # In Kaggle notebooks, terminating the kernel process immediately stops interactive/scheduled execution
    # and frees GPU quota. Use os._exit(0) after flushing stdio so the session halts cleanly.
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        from IPython import get_ipython
        ip = get_ipython()
        if ip is not None and getattr(ip, "kernel", None) is not None:
            ip.kernel.do_shutdown(restart=False)
    except Exception:
        pass
    os._exit(0)


