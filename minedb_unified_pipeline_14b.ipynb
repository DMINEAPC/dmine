def build_prompt(niche: str, text: str) -> str:
    user = f"Niche: {niche}\nSchema for extracted_data: {NICHE_SCHEMA[niche]}\n\nTEXT:\n{text}"
    msgs = [{"role": "system", "content": SYSTEM_PROMPT}, {"role": "user", "content": user}]
    return tokenizer.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)


NULL_STRINGS = {"unknown", "n/a", "na", "none", "null", "not specified", "not available", ""}


def clean_extracted_dict(d: dict) -> dict:
    """Normalize placeholder null strings into real JSON None and ensure at least 1 meaningful field."""
    cleaned = {}
    for k, v in d.items():
        if isinstance(v, str) and v.strip().lower() in NULL_STRINGS:
            cleaned[k] = None
        elif isinstance(v, list):
            cleaned[k] = [x for x in v if not (isinstance(x, str) and x.strip().lower() in NULL_STRINGS)]
        else:
            cleaned[k] = v
    return cleaned


def parse_reply(niche: str, reply: str):
    """Returns (parsed_obj_or_None, reason_tag)."""
    cleaned_reply = re.sub(r"^```(?:json)?\s*|\s*```$", "", reply.strip(), flags=re.IGNORECASE)
    s, e = cleaned_reply.find("{"), cleaned_reply.rfind("}") + 1
    if s == -1 or e <= s:
        return None, "invalid_json_bounds"
    try:
        obj = json.loads(cleaned_reply[s:e])
    except Exception:
        return None, "json_decode_error"

    if obj.get("is_sellable") is not True:
        return None, f"not_sellable(score={obj.get('value_score', '?')})"

    score = int(obj.get("value_score", 0))
    if score < MIN_VALUE_SCORE:
        return None, f"low_score({score}<{MIN_VALUE_SCORE})"

    if not isinstance(obj.get("extracted_data"), dict) or not obj["extracted_data"]:
        return None, "empty_schema"

    cleaned = clean_extracted_dict(obj["extracted_data"])

    # Enforce genuine Arabic script in arabic_nlp records so English marketing copy doesn't slip through
    if niche == "arabic_nlp":
        ar_txt = cleaned.get("clean_arabic_text") or ""
        ar_chars = len(ARABIC_CHAR_RE.findall(str(ar_txt)))
        if ar_chars < 25:
            return None, f"non_arabic_text(ar_chars={ar_chars})"

    non_null_fields = sum(1 for v in cleaned.values() if v not in (None, [], ""))
    if non_null_fields < 1:
        return None, "all_fields_null"

    obj["extracted_data"] = cleaned
    return obj, f"KEEP(score={score}, fields={non_null_fields})"


log(f"[5.1] Formatting & length-sorting {len(df)} prompts for batched inference (batch_size={LLM_BATCH_SIZE})...")
df = df.assign(prompt=[build_prompt(n, t) for n, t in zip(df["niche"], df["raw_text"])])
df = df.assign(plen=df["prompt"].str.len()).sort_values("plen")
rows = list(df.itertuples())
sellable = []
discard_reasons = {}
total_batches = (len(rows) + LLM_BATCH_SIZE - 1) // LLM_BATCH_SIZE
t_inf = time.time()

for b_idx, i in enumerate(range(0, len(rows), LLM_BATCH_SIZE), start=1):
    t_b = time.time()
    batch = rows[i:i + LLM_BATCH_SIZE]
    inputs = tokenizer(
        [r.prompt for r in batch],
        return_tensors="pt",
        padding=True,
        truncation=True,
        max_length=1536,
    ).to(model.device)
    with torch.inference_mode():
        out = model.generate(
            **inputs,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=False,
            pad_token_id=tokenizer.pad_token_id,
        )
    new_tokens = out[:, inputs["input_ids"].shape[1]:]
    decoded = tokenizer.batch_decode(new_tokens, skip_special_tokens=True)

    for r, reply in zip(batch, decoded):
        obj, reason = parse_reply(r.niche, reply.strip())
        short_url = (r.source_url[:62] + "...") if len(r.source_url) > 65 else r.source_url
        if obj:
            sellable.append({
                "niche": r.niche,
                "source_url": r.source_url,
                "scraped_at": r.scraped_at,
                "value_score": int(obj["value_score"]),
                "cleaned_json": json.dumps(obj["extracted_data"], ensure_ascii=False),
            })
            log(f"    + [{r.niche}] {reason} | {short_url}")
        else:
            tag = reason.split("(")[0]
            discard_reasons[tag] = discard_reasons.get(tag, 0) + 1
            log(f"    - [{r.niche}] DROP:{reason} | {short_url}")

    del inputs, out, new_tokens
    torch.cuda.empty_cache()
    peak_gb = torch.cuda.max_memory_allocated(0) / (1024 ** 3)
    done = min(i + LLM_BATCH_SIZE, len(rows))
    log(f"  -> Batch [{b_idx}/{total_batches}] ({done}/{len(rows)} pages) done in {time.time() - t_b:.1f}s | kept={len(sellable)} | peak_vram={peak_gb:.2f} GB")

log(f"[5.2] Quality gate finished in {time.time() - t_inf:.1f}s: {len(rows)} evaluated -> {len(sellable)} KEPT, {len(rows) - len(sellable)} DISCARDED.")
if discard_reasons:
    log(f"  -> Discard breakdown: {discard_reasons}")


