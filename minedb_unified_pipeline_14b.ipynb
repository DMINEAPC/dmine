def is_valid_wheel_cache(wheels_dir: str) -> bool:
    if not wheels_dir or not os.path.isdir(wheels_dir):
        return False
    files = [f.lower() for f in os.listdir(wheels_dir) if f.endswith(".whl")]
    return any(f.startswith(f"duckdb-{DUCKDB_VERSION}") for f in files)


def is_valid_model_cache(model_dir: str) -> bool:
    if not model_dir or not os.path.isdir(model_dir):
        return False
    files = os.listdir(model_dir)
    return "config.json" in files and any(f.endswith(".safetensors") for f in files)


def find_existing_cache():
    for root_dir in ("/kaggle/input", CACHE_TMP_ROOT):
        if not os.path.exists(root_dir):
            continue
        wheels_dir, model_dir = None, None
        for r, dirs, _ in os.walk(root_dir):
            if "wheels" in dirs and wheels_dir is None:
                cand = os.path.join(r, "wheels")
                if is_valid_wheel_cache(cand):
                    wheels_dir = cand
            if "model" in dirs and model_dir is None:
                cand = os.path.join(r, "model")
                if is_valid_model_cache(cand):
                    model_dir = cand
            if wheels_dir and model_dir:
                return wheels_dir, model_dir
    return None, None


def ensure_offline_cache():
    log("[1.3] Checking local disk (/kaggle/input & /tmp/minedb_cache) for existing cache...")
    wheels_dir, model_dir = find_existing_cache()
    if wheels_dir and model_dir:
        whl_count = len([f for f in os.listdir(wheels_dir) if f.endswith(".whl")])
        shard_count = len([f for f in os.listdir(model_dir) if f.endswith(".safetensors")])
        log(f"  -> CACHE HIT! Using local cache: wheels={wheels_dir} ({whl_count} .whl) | model={model_dir} ({shard_count} shards)")
        return wheels_dir, model_dir

    log(f"  -> No local cache found. Checking remote Kaggle Dataset '{DATASET_ID}'...")
    status = subprocess.run(
        ["kaggle", "datasets", "status", DATASET_ID],
        capture_output=True,
        text=True,
    )
    if status.returncode == 0:
        status_line = status.stdout.strip().splitlines()[-1] if status.stdout.strip() else "ready"
        log(f"  -> Remote dataset '{DATASET_ID}' exists (status: {status_line}). Attempting download to {CACHE_TMP_ROOT}...")
        t0 = time.time()
        shutil.rmtree(CACHE_TMP_ROOT, ignore_errors=True)
        os.makedirs(CACHE_TMP_ROOT, exist_ok=True)
        dl = subprocess.run(
            ["kaggle", "datasets", "download", "-d", DATASET_ID, "-p", CACHE_TMP_ROOT, "--unzip", "-q"],
            capture_output=True,
            text=True,
        )
        if dl.returncode == 0:
            wheels_dir, model_dir = find_existing_cache()
            if wheels_dir and model_dir:
                log(f"  -> Downloaded & verified cache in {time.time() - t0:.1f}s.")
                return wheels_dir, model_dir
            log("  -> Dataset downloaded but valid wheels/model folders were missing; rebuilding cache...")
        else:
            err_msg = (dl.stderr or dl.stdout).strip().splitlines()[-1] if (dl.stderr or dl.stdout).strip() else "unknown error"
            log(f"  -> Remote dataset download failed ({err_msg}) — dataset shell is empty/incomplete; rebuilding & re-publishing...")

    log(f"  -> Remote dataset not found. Starting first-time bootstrap for '{DATASET_ID}'...")
    shutil.rmtree(CACHE_TMP_ROOT, ignore_errors=True)
    wheels_dir = os.path.join(CACHE_TMP_ROOT, "wheels")
    model_dir = os.path.join(CACHE_TMP_ROOT, "model")
    os.makedirs(wheels_dir, exist_ok=True)
    os.makedirs(model_dir, exist_ok=True)

    t0 = time.time()
    log(f"  -> [Bootstrap 1/3] Downloading binary wheels: {REQUIRED_PKGS}...")
    subprocess.check_call(
        [
            sys.executable, "-m", "pip", "download", "-q",
            "--only-binary=:all:",
            "--dest", wheels_dir,
            *REQUIRED_PKGS,
        ],
        timeout=300,
    )
    log(f"  -> [Bootstrap 1/3] Downloaded {len(os.listdir(wheels_dir))} wheel files in {time.time() - t0:.1f}s.")

    t1 = time.time()
    log(f"  -> [Bootstrap 2/3] Downloading HuggingFace model snapshot '{MODEL_ID}'...")
    from huggingface_hub import snapshot_download
    snapshot_download(
        repo_id=MODEL_ID,
        local_dir=model_dir,
        ignore_patterns=["*.msgpack", "*.h5", "*.ot", "*.tflite", "*.bin"],
    )
    shutil.rmtree(os.path.join(model_dir, ".cache"), ignore_errors=True)
    log(f"  -> [Bootstrap 2/3] Model snapshot saved to {model_dir} in {time.time() - t1:.1f}s.")

    t2 = time.time()
    log(f"  -> [Bootstrap 3/3] Publishing '{DATASET_ID}' to Kaggle Datasets...")
    meta = {
        "title": DATASET_TITLE,
        "id": DATASET_ID,
        "licenses": [{"name": "CC0-1.0"}],
    }
    with open(os.path.join(CACHE_TMP_ROOT, "dataset-metadata.json"), "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=2)

    res = subprocess.run(
        ["kaggle", "datasets", "create", "-p", CACHE_TMP_ROOT, "--dir-mode", "zip"],
        capture_output=True,
        text=True,
    )
    if res.stdout.strip():
        log(f"     kaggle stdout: {res.stdout.strip()}")
    if res.stderr.strip():
        log(f"     kaggle stderr: {res.stderr.strip()}")
    if "Dataset creation error" in (res.stdout + res.stderr) or res.returncode != 0:
        log("  -> Dataset already exists or create returned non-zero; pushing new dataset version...")
        subprocess.run(
            ["kaggle", "datasets", "version", "-p", CACHE_TMP_ROOT, "-m", "Update cache", "--dir-mode", "zip"],
            check=False,
        )
    log(f"  -> [Bootstrap 3/3] Publish finished in {time.time() - t2:.1f}s.")
    return wheels_dir, model_dir


