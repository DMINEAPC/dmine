# ----------------------------- PII SCRUB (All niches for PDPL safety) --------
log(f"[4.1] Running PDPL PII scrubber (masking emails & phone numbers) across {len(df)} pages...")
EMAIL_RE = re.compile(r"[\w.+-]+@[\w-]+\.[\w.-]+")
PHONE_RE = re.compile(r"(?<!\d)(?:\+?\d[\d\s().-]{7,}\d)(?!\d)")
ARABIC_CHAR_RE = re.compile(r"[\u0600-\u06FF]")

pii_emails_masked = 0
pii_phones_masked = 0

def scrub_pii(text: str) -> str:
    global pii_emails_masked, pii_phones_masked
    text, n_e = EMAIL_RE.subn("[EMAIL]", text)
    text, n_p = PHONE_RE.subn("[PHONE]", text)
    pii_emails_masked += n_e
    pii_phones_masked += n_p
    return text

df["raw_text"] = df["raw_text"].map(scrub_pii)
log(f"  -> PII scrub complete: masked {pii_emails_masked} emails and {pii_phones_masked} phone numbers.")

